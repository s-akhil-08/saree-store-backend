# ==========================================
# DJANGO CORE CONFIGURATION
# ==========================================
SECRET_KEY=your-django-secret-key-here
DEBUG=False
DEMO_MODE=True
MASTER_ADMIN_USERNAME=master_admin
ALLOWED_HOSTS=*

# ==========================================
# POSTGRESQL DATABASE (Neon / Supabase / Render)
# ==========================================
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=postgres.your_project_id
DB_PASSWORD=your_database_password
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=6543

# ==========================================
# SUPABASE STORAGE CONFIGURATION
# ==========================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_BUCKET=product-images
WEBP_QUALITY=82
MAX_IMAGE_DIMENSION=2048

# ==========================================
# EMAIL / GMAIL SMTP (OTP & Notifications)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-google-app-password
DEFAULT_FROM_EMAIL=Silk & Loom <your-email@gmail.com>
ADMIN_NOTIFICATION_EMAIL=your-email@gmail.com

# ==========================================
# FRONTEND INTEGRATION & URLs
# ==========================================
FRONTEND_URL=https://your-frontend.vercel.app
ADMIN_LOGIN_URL=https://your-frontend.vercel.app/admin/login
WHATSAPP_NUMBER=919999999999

# ==========================================
# RATE LIMITING / THROTTLING
# ==========================================
THROTTLE_AUTH_IP_REQS=20
THROTTLE_AUTH_ACCOUNT_REQS=10
